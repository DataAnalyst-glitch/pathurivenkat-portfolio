rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Uploaded files (profile photo, resume, project screenshots) — public read, admin-only write
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == '0TWbzevaJ9cKIqQXfLwlJVZvajb2';
    }
  }
}
