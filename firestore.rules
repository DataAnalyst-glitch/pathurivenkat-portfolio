rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Portfolio project cards — public read, admin-only write
    match /projects/{projectId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == '0TWbzevaJ9cKIqQXfLwlJVZvajb2';
    }

    // Site settings (contact info, profile photo URL, resume URL, etc.) — public read, admin-only write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == '0TWbzevaJ9cKIqQXfLwlJVZvajb2';
    }

    // Skill groups shown in the Skills section — public read, admin-only write
    match /skills/{skillId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == '0TWbzevaJ9cKIqQXfLwlJVZvajb2';
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
